<!--
    Window geometry is sized to the *working* area, not the screen bounds.

    Height and Width were 1280x800, which is exactly this machine's screen. Centred inside a
    working area 48 units shorter once the taskbar is accounted for, the top edge lands at -24 and
    the title bar goes off the top of the display, taking the close button with it, so the
    application could not be shut without Alt+F4 or Task Manager.

    MaximizedPrimaryScreen* is the working area, so the clamp holds on any display: the window can
    be asked for larger than the screen and will still open with its caption reachable.
-->
<fluent:RibbonWindow x:Class="OpenMCAD.Shell.MainWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:fluent="urn:fluent-ribbon"
                     xmlns:avalondock="https://github.com/Dirkster99/AvalonDock"
                     xmlns:local="clr-namespace:OpenMCAD.Shell"
                     xmlns:vm="clr-namespace:OpenMCAD.ViewModels;assembly=OpenMCAD.ViewModels"
                     mc:Ignorable="d"
                     d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
                     Title="{Binding Title}"
                     Height="720"
                     Width="1160"
                     MinHeight="480"
                     MinWidth="720"
                     MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
                     MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}"
                     WindowStartupLocation="CenterScreen">

    <fluent:RibbonWindow.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!--
            Implicit template: any ToolPanel placed in the docking manager renders like this.
            An implicit DataTemplate keyed on the view model type is used in preference to
            DockingManager.LayoutItemTemplate, because that property applies to every layout item
            and would therefore also replace the viewport document with this template.
        -->
        <DataTemplate DataType="{x:Type vm:ToolPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Margin="12"
                           TextWrapping="Wrap"
                           Opacity="0.75"
                           Text="{Binding Placeholder}" />
            </ScrollViewer>
        </DataTemplate>

        <Style x:Key="AnchorableItemStyle" TargetType="{x:Type avalondock:LayoutAnchorableItem}">
            <!-- AvalonDock projects the source item onto the LayoutAnchorable, so Title and
                 ContentId are read from the Model, not from Model.Content. -->
            <Setter Property="Title" Value="{Binding Model.Title}" />
            <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
            <Setter Property="CanClose" Value="False" />
        </Style>

        <Style x:Key="DocumentItemStyle" TargetType="{x:Type avalondock:LayoutDocumentItem}">
            <Setter Property="CanClose" Value="False" />
        </Style>

        <local:LayoutItemStyleSelector x:Key="LayoutItemStyles"
                                       AnchorableStyle="{StaticResource AnchorableItemStyle}"
                                       DocumentStyle="{StaticResource DocumentItemStyle}" />
    </fluent:RibbonWindow.Resources>

    <DockPanel>

        <!-- Ribbon (P0-T10 skeleton; the full command surface lands in P6-T01). -->
        <fluent:Ribbon DockPanel.Dock="Top">
            <fluent:Ribbon.Menu>
                <fluent:Backstage Header="File">
                    <fluent:BackstageTabControl>
                        <fluent:BackstageTabItem Header="About">
                            <StackPanel Margin="24">
                                <TextBlock Text="{Binding Title}" FontSize="24" />
                                <TextBlock Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           MaxWidth="640"
                                           Text="A parametric, feature-based mechanical CAD system for Windows. This is the Phase 0 skeleton: the shell launches, logs, and docks. No geometry exists yet." />
                            </StackPanel>
                        </fluent:BackstageTabItem>
                    </fluent:BackstageTabControl>
                </fluent:Backstage>
            </fluent:Ribbon.Menu>

            <fluent:RibbonTabItem Header="Home">
                <fluent:RibbonGroupBox Header="Sketch">
                    <fluent:Button Header="New Sketch" IsEnabled="False" SizeDefinition="Large" />
                </fluent:RibbonGroupBox>
                <fluent:RibbonGroupBox Header="Features">
                    <fluent:Button Header="Extrude" IsEnabled="False" SizeDefinition="Large" />
                    <fluent:Button Header="Revolve" IsEnabled="False" SizeDefinition="Large" />
                    <fluent:Button Header="Fillet" IsEnabled="False" SizeDefinition="Large" />
                </fluent:RibbonGroupBox>

            </fluent:RibbonTabItem>

            <!--
                Plugin contributions get a tab of their own rather than being mixed into Home, so
                a plugin can never displace or reorder a built-in command. Office and SolidWorks
                both put add-ins on their own tab for the same reason.

                One group box holding every contributed command. A RibbonTabItem exposes an
                ObservableCollection<RibbonGroupBox> rather than an ItemsSource, so a box per
                plugin group would mean constructing ribbon controls in code-behind; the group name
                is carried on each command so that can be done when plugins offer enough to need
                it. RibbonGroupBox is itself an ItemsControl, which is what makes this much
                declarative.

                The tab is collapsed when nothing contributed, which is the ordinary case: an empty
                "Add-Ins" tab reads as something having gone wrong.
            -->
            <fluent:RibbonTabItem Header="Add-Ins"
                                  Visibility="{Binding HasPluginCommands,
                                               Converter={StaticResource BooleanToVisibility}}">
                <fluent:RibbonGroupBox Header="Add-Ins"
                                       ItemsSource="{Binding PluginCommands}">
                    <fluent:RibbonGroupBox.ItemTemplate>
                        <DataTemplate>
                            <fluent:Button Header="{Binding Label}"
                                           SizeDefinition="Large"
                                           Click="OnPluginCommandClick"
                                           ToolTip="{Binding Description}" />
                        </DataTemplate>
                    </fluent:RibbonGroupBox.ItemTemplate>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <fluent:RibbonTabItem Header="View">
                <fluent:RibbonGroupBox Header="Orientation">
                    <fluent:Button Header="Zoom to Fit" IsEnabled="False" SizeDefinition="Large" />
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>
        </fluent:Ribbon>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}" />
        </StatusBar>

        <!-- Docking layout (P0-T10 skeleton; persisted per-user layouts land in P6-T02). -->
        <avalondock:DockingManager x:Name="Docking"
                                   AnchorablesSource="{Binding Panels}"
                                   LayoutItemContainerStyleSelector="{StaticResource LayoutItemStyles}">
            <avalondock:LayoutRoot>
                <avalondock:LayoutPanel Orientation="Horizontal">
                    <avalondock:LayoutAnchorablePaneGroup DockWidth="340" Orientation="Vertical">
                        <avalondock:LayoutAnchorablePane />
                    </avalondock:LayoutAnchorablePaneGroup>
                    <avalondock:LayoutDocumentPaneGroup>
                        <avalondock:LayoutDocumentPane>
                            <avalondock:LayoutDocument Title="Viewport" ContentId="Viewport" CanClose="False">
                                <!--
                                    The D3D12 surface (P2-T02). An airspace child window, so
                                    nothing in WPF can be drawn over it: overlays belong in the
                                    viewport's own rendering, not layered here in XAML.
                                -->
                                <local:ViewportHost x:Name="Viewport" />
                            </avalondock:LayoutDocument>
                        </avalondock:LayoutDocumentPane>
                    </avalondock:LayoutDocumentPaneGroup>
                </avalondock:LayoutPanel>
            </avalondock:LayoutRoot>
        </avalondock:DockingManager>

    </DockPanel>
</fluent:RibbonWindow>
